# Web server configuration for the Triangle Rowing Club website.
# Uploaded to /srv/trc/Caddyfile by the deploy job; /etc/caddy/Caddyfile
# (from deploy/cloud-init.yaml) imports it.
# Caddy obtains and renews HTTPS certificates automatically.

dev.trianglerowing.org {
	root * /srv/trc/site
	encode zstd gzip

	# Old SportsEngine addresses -> new pages (301). Generated by Hugo from
	# data/redirects.yaml and uploaded by the deploy job.
	import /srv/trc/redirects.caddy

	header {
		# Development site: keep it out of search engines until launch.
		X-Robots-Tag "noindex, nofollow"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	file_server
}

# Launch cutover (a separate, planned step; see
# docs/decisions/0001-platform-and-hosting.md): replace the site address above
# with "trianglerowing.org, www.trianglerowing.org", delete the X-Robots-Tag
# line, and set params.noindex = false in hugo.toml. Until then
# trianglerowing.org and www stay on SportsEngine.
